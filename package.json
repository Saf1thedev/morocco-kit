{
	"name": "morocco-kit",
	"version": "0.1.0",
	"description": "TypeScript toolkit for Morocco: phone, holidays, regions, MAD formatting. Zero runtime dependencies.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"files": ["dist", "src"],
	"scripts": {
		"build": "tsup",
		"prepare": "npm run build",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"fast-check": "3.23.2",
		"tsup": "8.4.0",
		"typescript": "5.7.3",
		"vitest": "2.1.9",
		"@vitest/coverage-v8": "2.1.9"
	},
	"private": false
}
